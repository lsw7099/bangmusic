[Unit]
Description=BangMusic server
After=network-online.target
Wants=network-online.target

[Service]
User=bangmusic
Group=bangmusic
EnvironmentFile=/etc/bangmusic/env
ExecStart=/usr/local/bin/node /opt/bangmusic/current/server/src/main.ts serve
Restart=on-failure
RestartSec=5
# 음악 원본(/srv/music)을 포함해 데이터·캐시 외에는 쓸 수 없다 (01장 §2.2의 두 번째 겹)
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/bangmusic /var/cache/bangmusic
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
