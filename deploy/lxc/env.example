# BangMusic 서버 설정 (/etc/bangmusic/env). 비밀값은 넣지 않는다 — 서명 키는 데이터 폴더에 자동 생성된다.
# 값에 공백이나 괄호가 있으면 큰따옴표로 감싼다.
BANGMUSIC_DATA_DIR=/var/lib/bangmusic
BANGMUSIC_CACHE_DIR=/var/cache/bangmusic
BANGMUSIC_HOST=0.0.0.0
BANGMUSIC_PORT=8080
BANGMUSIC_SERVER_NAME="우리집 음악"
BANGMUSIC_LOG_LEVEL=info
# 리버스 프록시(NPM·Caddy 등) 뒤에 두면 그 주소. 여러 개면 쉼표로 구분
#BANGMUSIC_TRUST_PROXY=192.168.0.5
# 매일 백업 시각(UTC, 0~23). -1이면 끔
#BANGMUSIC_BACKUP_HOUR_UTC=18
