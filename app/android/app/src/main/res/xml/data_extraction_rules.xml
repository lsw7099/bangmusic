<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: 클라우드 백업·기기 이전에서 프로필 데이터(다운로드·로컬 DB) 제외 (03장 §5.7).
     다른 기기에서 토큰 없이 파일만 복원되는 상태를 막는다. 토큰은 보안 저장소 키가 기기에 묶여 어차피 복원되지 않는다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="profiles/"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="profiles/"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
